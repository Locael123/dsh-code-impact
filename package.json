{
	"name": "dsh-code-impact",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Post-edit impact checks for the harness: a symbol index, reference graph, and inheritance model that answer what an edit touched, from an index instead of a re-scan.",
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"cordis",
		"code-intelligence",
		"code-impact",
		"symbol-index",
		"code-navigation",
		"impact-analysis"
	],
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./client": "./client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"index.js",
		"client.js",
		"lib/lex.js",
		"lib/files.js",
		"lib/lang-js.js",
		"lib/lang-go.js",
		"lib/store.js",
		"lib/resolve.js",
		"lib/query.js",
		"lib/tools.js",
		"lib/feed.js",
		"lib/web.js",
		"locale/en.json",
		"locale/zh.json",
		"icon.svg",
		"cordis.patch.yml",
		"README.md",
		"README.zh.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": []
		}
	}
}
